<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
 xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
 xmlns:global="http://schemas.microsoft.com/dotnet/maui/global"
 xmlns:system="clr-namespace:System;assembly=System.Runtime"
 x:Class="AICalendar.Client.CalendarEventPopup"
 x:DataType="global:CalendarEventPopupViewModel"
 BackgroundColor="Gray">
	<VerticalStackLayout Spacing="16">
		<Label>
			<Label.FormattedText>
				<FormattedString>
					<Span FontSize="18" Text="{Binding Event.Subject}"></Span>
					<Span FontSize="18" Text=" by "></Span>
					<Span FontSize="18" Text="{Binding Event.OrganizerId}"></Span>
				</FormattedString>
			</Label.FormattedText>
		</Label>
		<Label>
			<Label.FormattedText>
				<FormattedString>
					<Span Text="{Binding Event.StartTime}"></Span>
					<Span Text=" - "></Span>
					<Span Text="{Binding Event.EndTime}"></Span>
				</FormattedString>
			</Label.FormattedText>
		</Label>
		<CollectionView ItemsSource="{Binding Event.Attendees}">
			<CollectionView.ItemTemplate>
				<DataTemplate x:DataType="system:String">
					<Label Text="{Binding }" FontSize="14" />
				</DataTemplate>
			</CollectionView.ItemTemplate>
		</CollectionView>
		<Button Text="Cancel Event" Command="{Binding CancelEventCommand}" BackgroundColor="Red" TextColor="White" />
		<Button Text="Close" Command="{Binding CloseCommand}" />
	</VerticalStackLayout>
</toolkit:Popup>
