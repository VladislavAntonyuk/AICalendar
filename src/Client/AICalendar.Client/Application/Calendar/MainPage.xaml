<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="AICalendar.Client.Application.Calendar.MainPage"
             Shell.FlyoutBehavior="Disabled"
             x:DataType="MainPageViewModel"
             x:Name="HomePage">

	<ContentPage.ToolbarItems>
		<ToolbarItem Text="{Binding Username}"></ToolbarItem>
		<ToolbarItem Text="Logout"
		             Command="{Binding LogoutCommand}"/>
	</ContentPage.ToolbarItems>

	<Grid>
		<SfScheduler
					BackgroundColor="Gray"
					View="Month"
					AllowAppointmentDrag="False"
					AppointmentsSource="{Binding Appointments}"
					TappedCommand="{Binding TappedCommand}"
					ViewChangedCommand="{Binding RefreshCalendarCommand}">
			<SfScheduler.MonthView>
				<SchedulerMonthView AppointmentDisplayMode="Text">
					<SchedulerMonthView.AppointmentTemplate>
						<DataTemplate x:DataType="SchedulerAppointment">
							<Border Background="{Binding Background}"
							        StrokeShape="RoundRectangle 5">
								<Label
									AutomationId="{Binding Subject}"
									Text="{Binding Subject}"
									Margin="15, 0, 0, 0"
									FontSize="12"/>
							</Border>
						</DataTemplate>
					</SchedulerMonthView.AppointmentTemplate>
				</SchedulerMonthView>
			</SfScheduler.MonthView>
		</SfScheduler>

		<Button
				HorizontalOptions="End"
				VerticalOptions="End"
				Margin="0, 0, 30, 30"
				Text ="+"
				Command="{Binding CreateEventCommand}"/>

	</Grid>

</ContentPage>
