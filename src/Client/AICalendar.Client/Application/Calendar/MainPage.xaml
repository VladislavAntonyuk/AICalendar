<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:global="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:shared="clr-namespace:AICalendar.Shared;assembly=AICalendar.Shared"
             xmlns:scheduler="http://schemas.syncfusion.com/maui"
             xmlns:main="clr-namespace:AICalendar.Client.Application.Calendar.Main"
             x:Class="AICalendar.Client.Application.Calendar.MainPage"
             Shell.FlyoutBehavior="Disabled"
             x:DataType="main:MainPageViewModel"
             x:Name="HomePage">

	<ContentPage.ToolbarItems>
		<ToolbarItem Text="{Binding Username}"></ToolbarItem>
		<ToolbarItem Text="Logout"
		             Command="{Binding LogoutCommand}"/>
	</ContentPage.ToolbarItems>

	<Grid>
		<scheduler:SfScheduler
					BackgroundColor="Gray"
					View="Month"
					AllowAppointmentDrag="False"
					AppointmentsSource="{Binding Appointments}"
					TappedCommand="{Binding TappedCommand}"
					ViewChangedCommand="{Binding RefreshCalendarCommand}"/>

		<Button
				HorizontalOptions="End"
				VerticalOptions="End"
				Margin="0 0 30 30"
				Text ="+"
				Command="{Binding CreateEventCommand}"/>

	</Grid>

</ContentPage>
