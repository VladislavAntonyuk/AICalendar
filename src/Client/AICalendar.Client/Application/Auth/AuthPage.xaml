<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:global="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:auth="clr-namespace:AICalendar.Client.Application.Auth"
             x:Class="AICalendar.Client.Application.Auth.AuthPage"
			 Shell.NavBarIsVisible="False"
			 Shell.PresentationMode="ModalAnimated"
             Shell.FlyoutBehavior="Disabled"
             x:DataType="auth:AuthPageViewModel">

	<ScrollView>
		<VerticalStackLayout
            Padding="30,0"
            Spacing="25">

			<Image
				Source="logo.png"
				MaximumHeightRequest="500"/>

			<Button
				Text="Login"
				Command="{Binding LoginCommand}"/>
		</VerticalStackLayout>
	</ScrollView>

</ContentPage>
