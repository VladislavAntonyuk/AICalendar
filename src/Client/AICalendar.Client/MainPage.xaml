<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Plugin.Maui.Calendar.Controls;assembly=Plugin.Maui.Calendar"
             xmlns:global="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:shared="clr-namespace:AICalendar.Shared;assembly=AICalendar.Shared"
             x:Class="AICalendar.Client.MainPage"
             x:DataType="global:MainPageViewModel">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
			<controls:Calendar
				Events="{Binding Events}" MonthChanged="Calendar_OnMonthChanged">
				<controls:Calendar.EventTemplate>
					<DataTemplate x:DataType="shared:CalendarEvent">
						<StackLayout
							Padding="15,0,0,0">
							<Label
								Text="{Binding Title}"
								FontAttributes="Bold"
								FontSize="Medium" />
						</StackLayout>
					</DataTemplate>
				</controls:Calendar.EventTemplate>
			</controls:Calendar>
		</VerticalStackLayout>
    </ScrollView>

</ContentPage>
