<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:global="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:shared="clr-namespace:AICalendar.Shared;assembly=AICalendar.Shared"
             xmlns:scheduler="http://schemas.syncfusion.com/maui"
             x:Class="AICalendar.Client.MainPage"
             x:DataType="global:MainPageViewModel"
             x:Name="HomePage">

	<ScrollView>
		<Grid RowSpacing="10"
		      RowDefinitions="Auto, *">
			<Button Text="Logout"
					Grid.Row="0"
			        Command="{Binding LogoutCommand}"/>

			<scheduler:SfScheduler
					Grid.Row="1"
					View="Month"
					AllowAppointmentDrag="False"
					AppointmentsSource="{Binding Appointments}"
					TappedCommand="{Binding TappedCommand}"
					ViewChangedCommand="{Binding RefreshCalendarCommand}"/>

		</Grid>
	</ScrollView>

</ContentPage>
