<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Plugin.Maui.Calendar.Controls;assembly=Plugin.Maui.Calendar"
             xmlns:global="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:shared="clr-namespace:AICalendar.Shared;assembly=AICalendar.Shared"
             x:Class="AICalendar.Client.AuthPage"
			 Shell.NavBarIsVisible="False"
			 Shell.PresentationMode="ModalAnimated"
             x:DataType="global:AuthPageViewModel">

	<ScrollView>
		<VerticalStackLayout
            Padding="30,0"
            Spacing="25">
			<Button
				Text="Login"
				Command="{Binding LoginCommand}"/>
		</VerticalStackLayout>
	</ScrollView>

</ContentPage>
